              "mode": "raw",
              "raw": "{ \"status\": \"IN_PROGRESS\", \"stageId\": \"{{createdStageId}}\" }",
              "options": { "raw": { "language": "json" } }
            }
          }
        },
        {          "name": "TC-TASK-02B Set task progress=100 before IN_REVIEW",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('Progress is 100', () => pm.expect(body.progress).to.equal(100));"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{managerToken}}" },
              { "key": "X-Company-ID",  "value": "{{tenantId}}" },
              { "key": "X-User-ID",     "value": "{{managerId}}" },
              { "key": "Content-Type",  "value": "application/json" }
            ],
            "url": "{{baseUrl}}/api/projects/tasks/{{createdTaskId}}",
            "body": {
              "mode": "raw",
              "raw": "{ \"title\": \"TC-TASK-01 Auto Task\", \"status\": \"IN_PROGRESS\", \"priority\": \"MEDIUM\", \"progress\": 100, \"actualEffort\": 8, \"assigneeIds\": [\"{{employeeId}}\"], \"reporterId\": \"{{managerId}}\" }",
              "options": { "raw": { "language": "json" } }
            }
          }
        },
        {          "name": "TC-TASK-03 Move task IN_PROGRESS → IN_REVIEW (valid transition)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
