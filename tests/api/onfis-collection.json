              { "key": "X-Company-ID",  "value": "{{tenantId}}" },
              { "key": "X-User-ID",     "value": "{{managerId}}" },
              { "key": "Content-Type",  "value": "application/json" }
            ],
            "url": "{{baseUrl}}/api/projects/tasks/{{createdTaskId}}/stage",
            "body": {
              "mode": "raw",
              "raw": "{ \"status\": \"IN_REVIEW\", \"stageId\": \"{{createdStageId}}\" }",
              "options": { "raw": { "language": "json" } }
            }
          }
        },
