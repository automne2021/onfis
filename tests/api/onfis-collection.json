  "item": [

    {
      "name": "TC-AUTH — Authentication",
      "item": [
        {
          "name": "TC-AUTH-01 Login as Manager (valid)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('access_token present', () => pm.expect(body.access_token).to.be.a('string'));",
                  "pm.collectionVariables.set('managerToken', body.access_token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "apikey", "value": "{{supabaseAnonKey}}" }
            ],
            "url": "{{supabaseUrl}}/auth/v1/token?grant_type=password",
            "body": {
              "mode": "raw",
              "raw": "{ \"email\": \"{{managerEmail}}\", \"password\": \"{{testPassword}}\" }",
              "options": { "raw": { "language": "json" } }
            }
          }
        },
        {
          "name": "TC-AUTH-02 Login as Employee (valid)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('access_token present', () => pm.expect(body.access_token).to.be.a('string'));",
                  "pm.collectionVariables.set('employeeToken', body.access_token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "apikey", "value": "{{supabaseAnonKey}}" }
            ],
            "url": "{{supabaseUrl}}/auth/v1/token?grant_type=password",
            "body": {
              "mode": "raw",
              "raw": "{ \"email\": \"{{employeeEmail}}\", \"password\": \"{{testPassword}}\" }",
              "options": { "raw": { "language": "json" } }
            }
          }
        },
        {
          "name": "TC-AUTH-03 Login with wrong password",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 400 or 401', () => pm.expect([400, 401]).to.include(pm.response.code));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "apikey", "value": "{{supabaseAnonKey}}" }
            ],
            "url": "{{supabaseUrl}}/auth/v1/token?grant_type=password",
            "body": {
              "mode": "raw",
              "raw": "{ \"email\": \"{{managerEmail}}\", \"password\": \"WrongPassword!\" }",
              "options": { "raw": { "language": "json" } }
            }
          }
        },
        {
          "name": "TC-AUTH-04 Access protected API without token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 401 or 403', () => pm.expect([401, 403]).to.include(pm.response.code));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "X-Company-ID", "value": "{{tenantId}}" }
            ],
            "url": "{{baseUrl}}/api/projects"
          }
        },
        {
          "name": "TC-AUTH-05 Get current user (/users/me)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('userId present', () => pm.expect(body.id || body.userId).to.be.a('string'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{managerToken}}" },
              { "key": "X-Company-ID",  "value": "{{tenantId}}" },
              { "key": "X-User-ID",     "value": "{{managerId}}" }
            ],
            "url": "{{baseUrl}}/api/users/me"
          }
        }
      ]
