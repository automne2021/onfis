    {
      "name": "TC-TENANT — Multi-Tenant Security",
      "item": [
        {
          "name": "TC-TENANT-01 List projects with correct tenant",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{managerToken}}" },
              { "key": "X-Company-ID",  "value": "{{tenantId}}" },
              { "key": "X-User-ID",     "value": "{{managerId}}" }
            ],
            "url": "{{baseUrl}}/api/projects"
          }
        },
        {
          "name": "TC-TENANT-02 List projects with wrong tenant ID (cross-tenant isolation)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// Gateway derives tenant from URL path (/{slug}/api/...) and IGNORES",
                  "// any X-Company-ID header sent by the client — this IS the isolation mechanism.",
                  "// Sending a fake X-Company-ID must NOT change which tenant's data is returned.",
                  "pm.test('Status is 200 — gateway uses URL path, not client-supplied X-Company-ID', () => {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Response is valid JSON (fake header was ignored)', () => {",
                  "  pm.response.to.be.json;",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{managerToken}}" },
              { "key": "X-Company-ID",  "value": "00000000-0000-0000-0000-000000000000" },
              { "key": "X-User-ID",     "value": "{{managerId}}" }
            ],
            "url": "{{baseUrl}}/api/projects"
          }
        },
        {
          "name": "TC-TENANT-03 Health check — API Gateway up",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{managerToken}}" },
              { "key": "X-Company-ID",  "value": "{{tenantId}}" }
            ],
            "url": "{{baseUrl}}/api/projects/health"
          }
        }
      ]
    },

