{
  "info": {
    "name": "ONFIS System Tests",
    "_postman_id": "onfis-system-tests-v1",
    "description": "Automated API integration tests for the ONFIS ERP platform.\nRun with: newman run tests/api/onfis-collection.json -e tests/api/environments/local.json",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "managerToken",  "value": "" },
    { "key": "employeeToken", "value": "" },
    { "key": "createdProjectId", "value": "" },
    { "key": "createdTaskId",    "value": "" },
